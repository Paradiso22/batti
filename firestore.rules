rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Modello Splid: l'ID gruppo e' un UUID non indovinabile e fa da segreto.
    // Si legge/scrive un gruppo solo conoscendone l'ID; elencare i gruppi e' vietato.
    match /groups/{groupId} {
      allow get: if true;
      allow list, delete: if false;

      // La CREAZIONE e' riservata a chi conosce il codice proprietario.
      // NB: nel repo c'e' un segnaposto; il codice vero sta solo nelle regole
      // pubblicate sulla console Firebase.
      allow create: if request.resource.data.ownerKey == 'METTI-QUI-IL-CODICE-VERO'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.members.size() <= 30;

      // La MODIFICA (aggiungere membri, budget, ricorrenti, rinomina) e' consentita
      // a chi ha il link, ma non puo' cambiare il codice proprietario ne' gonfiare il doc.
      allow update: if request.resource.data.ownerKey == resource.data.ownerKey
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.members.size() <= 30;

      // chat del gruppo: testo corto e foto compressa, niente allegati enormi
      match /messages/{messageId} {
        allow read, delete: if true;
        allow create, update: if request.resource.data.from is string
                              && (!('text' in request.resource.data) || request.resource.data.text.size() <= 500)
                              && (!('photo' in request.resource.data) || request.resource.data.photo.size() <= 900000);
      }

      match /expenses/{expenseId} {
        allow read, delete: if true;
        // Le spese devono avere forma valida: importo intero non negativo e
        // ragionevole, descrizione corta. Blocca scritture-spazzatura e abusi.
        allow create, update: if request.resource.data.amount is int
                              && request.resource.data.amount >= 0
                              && request.resource.data.amount <= 100000000
                              && request.resource.data.paidBy is string
                              && request.resource.data.paidBy.size() <= 64
                              && (!('desc' in request.resource.data) || (request.resource.data.desc is string && request.resource.data.desc.size() <= 200));
      }
    }
  }
}
